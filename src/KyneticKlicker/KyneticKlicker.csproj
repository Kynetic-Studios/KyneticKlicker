<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KyneticKlicker</AssemblyName>
    <RootNamespace>KyneticKlicker</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <Version>1.0.0</Version>
    <Company>KyneticStudios LLC</Company>
    <Product>Kynetic Klicker</Product>
    <Authors>KyneticStudios LLC</Authors>
    <Description>Proprietary external 13 CPS clicker utility for Kynetic-owned Minecraft servers.</Description>
    <PublishTrimmed>false</PublishTrimmed>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <Copyright>Copyright © 2026 KyneticStudios LLC</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\kynetic-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
